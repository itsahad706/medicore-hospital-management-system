<%- include('../partials/app-top') %>

<div class="page-header no-print">
  <div><h1>Prescription — <%= new Date(prescription.created_at).toLocaleDateString() %></h1></div>
  <button class="btn btn-outline-secondary" data-print><i class="bi bi-printer me-1"></i>Print</button>
</div>

<div class="invoice-box">
  <div class="d-flex justify-content-between mb-4">
    <div><span class="company-name text-primary">MediCore HMS</span><div class="text-muted small">Prescription</div></div>
    <div class="text-end">
      <div class="text-muted small"><%= new Date(prescription.created_at).toLocaleDateString() %></div>
      <div class="fw-semibold">Dr. <%= prescription.doctor_name %></div>
    </div>
  </div>

  <table class="table hms-table">
    <thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Qty</th></tr></thead>
    <tbody>
      <% items.forEach(i => { %>
        <tr>
          <td><%= i.medicine_name %></td>
          <td><%= i.dosage || '—' %></td>
          <td><%= i.frequency || '—' %></td>
          <td><%= i.duration || '—' %></td>
          <td><%= i.quantity %> <%= i.unit %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (prescription.notes) { %>
    <div class="mt-3"><div class="text-muted small">Notes</div><div><%= prescription.notes %></div></div>
  <% } %>
</div>

<%- include('../partials/app-bottom') %>
