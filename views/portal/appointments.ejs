<%- include('../partials/app-top') %>

<div class="page-header">
  <div><h1>My Appointments</h1></div>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table hms-table mb-0">
      <thead><tr><th>Date</th><th>Time</th><th>Doctor</th><th>Reason</th><th>Status</th></tr></thead>
      <tbody>
        <% if (appointments.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-4">You have no appointments on record. Contact the front desk to book one.</td></tr><% } %>
        <% appointments.forEach(a => { %>
          <tr>
            <td><%= new Date(a.appointment_date).toLocaleDateString() %></td>
            <td><%= a.appointment_time %></td>
            <td>Dr. <%= a.doctor_name %></td>
            <td><%= a.reason || '—' %></td>
            <td><span class="badge badge-status bg-<%= a.status==='completed'?'success':a.status==='cancelled'||a.status==='no_show'?'danger':'primary' %>"><%= a.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/app-bottom') %>
