<%- include('../partials/app-top') %>
<div class="page-header">
  <div><h1>Departments</h1></div>
  <% if (currentUser.role === 'admin') { %>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newDeptModal"><i class="bi bi-plus-lg me-1"></i>Add Department</button>
  <% } %>
</div>

<div class="row g-3">
  <% departments.forEach(d => { %>
    <div class="col-md-4">
      <div class="portal-card h-100">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <strong><%= d.name %></strong>
            <div class="text-muted small mt-1"><%= d.description || 'No description' %></div>
          </div>
          <span class="badge bg-secondary"><%= d.doctor_count %> doctor<%= d.doctor_count == 1 ? '' : 's' %></span>
        </div>
        <% if (currentUser.role === 'admin') { %>
        <div class="mt-3 d-flex gap-2">
          <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editDept<%= d.id %>">Edit</button>
          <form method="POST" action="/departments/<%= d.id %>?_method=DELETE" data-confirm="Delete this department?">
            <%- include('../partials/csrf') %>
            <button class="btn btn-sm btn-outline-danger">Delete</button>
          </form>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Edit modal -->
    <div class="modal fade" id="editDept<%= d.id %>">
      <div class="modal-dialog"><div class="modal-content">
        <form method="POST" action="/departments/<%= d.id %>?_method=PUT">
          <%- include('../partials/csrf') %>
          <div class="modal-header"><h5 class="modal-title">Edit Department</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
          <div class="modal-body">
            <div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="name" value="<%= d.name %>" required></div>
            <div class="mb-3"><label class="form-label">Description</label><input class="form-control" name="description" value="<%= d.description || '' %>"></div>
          </div>
          <div class="modal-footer"><button class="btn btn-primary">Save</button></div>
        </form>
      </div></div>
    </div>
  <% }) %>
</div>

<div class="modal fade" id="newDeptModal">
  <div class="modal-dialog"><div class="modal-content">
    <form method="POST" action="/departments">
      <%- include('../partials/csrf') %>
      <div class="modal-header"><h5 class="modal-title">Add Department</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label">Name</label><input class="form-control" name="name" required></div>
        <div class="mb-3"><label class="form-label">Description</label><input class="form-control" name="description"></div>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Add</button></div>
    </form>
  </div></div>
</div>

<%- include('../partials/app-bottom') %>
