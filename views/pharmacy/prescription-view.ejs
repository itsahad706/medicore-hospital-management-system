<%- include('../partials/app-top') %>

<div class="page-header no-print">
  <div><h1>Prescription #<%= prescription.id %></h1></div>
  <div class="d-flex gap-2">
    <button class="btn btn-outline-secondary" data-print><i class="bi bi-printer me-1"></i>Print</button>
    <% if ((currentUser.role === 'admin' || currentUser.role === 'receptionist') && prescription.status === 'pending') { %>
      <form method="POST" action="/pharmacy/prescriptions/<%= prescription.id %>/dispense?_method=PUT">
        <%- include('../partials/csrf') %>
        <button class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Mark Dispensed</button>
      </form>
    <% } %>
  </div>
</div>

<div class="invoice-box">
  <div class="d-flex justify-content-between mb-4">
    <div><span class="company-name text-primary">MediCore HMS</span><div class="text-muted small">Prescription</div></div>
    <div class="text-end">
      <div><strong>#<%= prescription.id %></strong></div>
      <div class="text-muted small"><%= new Date(prescription.created_at).toLocaleDateString() %></div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-6">
      <div class="text-muted small">Patient</div>
      <div class="fw-semibold"><%= prescription.patient_name %> (<%= prescription.mrn %>)</div>
    </div>
    <div class="col-6 text-end">
      <div class="text-muted small">Prescribing Doctor</div>
      <div class="fw-semibold">Dr. <%= prescription.doctor_name %></div>
    </div>
  </div>

  <table class="table hms-table">
    <thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Qty</th></tr></thead>
    <tbody>
      <% items.forEach(i => { %>
        <tr>
          <td><%= i.medicine_name %></td>
          <td><%= i.dosage || '—' %></td>
          <td><%= i.frequency || '—' %></td>
          <td><%= i.duration || '—' %></td>
          <td><%= i.quantity %> <%= i.unit %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (prescription.notes) { %>
    <div class="mt-3"><div class="text-muted small">Notes</div><div><%= prescription.notes %></div></div>
  <% } %>

  <div class="mt-4">
    <span class="badge badge-status bg-<%= prescription.status==='dispensed'?'success':'warning' %>"><%= prescription.status %></span>
  </div>
</div>

<%- include('../partials/app-bottom') %>
