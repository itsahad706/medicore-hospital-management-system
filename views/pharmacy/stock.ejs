<%- include('../partials/app-top') %>

<div class="page-header">
  <div><h1>Stock</h1></div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newStockModal"><i class="bi bi-plus-lg me-1"></i>Receive Stock</button>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table hms-table mb-0">
      <thead><tr><th>Medicine</th><th>Batch #</th><th>Quantity</th><th>Purchase Price</th><th>Expiry</th><th>Received</th><th></th></tr></thead>
      <tbody>
        <% if (stock.length === 0) { %><tr><td colspan="7" class="text-center text-muted py-4">No stock batches recorded.</td></tr><% } %>
        <% stock.forEach(s => { %>
          <% const isExpiringSoon = s.expiry_date && (new Date(s.expiry_date) - new Date()) < 30*24*60*60*1000; %>
          <tr>
            <td><%= s.medicine_name %></td>
            <td><%= s.batch_no || '—' %></td>
            <td><%= s.quantity %> <%= s.unit %></td>
            <td><%= Number(s.purchase_price).toFixed(2) %></td>
            <td>
              <%= s.expiry_date ? new Date(s.expiry_date).toLocaleDateString() : '—' %>
              <% if (isExpiringSoon) { %><span class="badge bg-warning text-dark ms-1">Expiring soon</span><% } %>
            </td>
            <td><%= new Date(s.received_date).toLocaleDateString() %></td>
            <td class="text-end">
              <form method="POST" action="/pharmacy/stock/<%= s.id %>?_method=DELETE" class="d-inline" data-confirm="Remove this batch?">
                <%- include('../partials/csrf') %>
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="modal fade" id="newStockModal">
  <div class="modal-dialog"><div class="modal-content">
    <form method="POST" action="/pharmacy/stock">
      <%- include('../partials/csrf') %>
      <div class="modal-header"><h5 class="modal-title">Receive Stock</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-2">
          <label class="form-label">Medicine</label>
          <select class="form-select" name="medicine_id" required>
            <% medicines.forEach(m => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
          </select>
        </div>
        <div class="row g-2">
          <div class="col-6"><label class="form-label">Batch No.</label><input class="form-control" name="batch_no"></div>
          <div class="col-6"><label class="form-label">Quantity</label><input type="number" class="form-control" name="quantity" required></div>
          <div class="col-6"><label class="form-label">Purchase Price</label><input type="number" step="0.01" class="form-control" name="purchase_price"></div>
          <div class="col-6"><label class="form-label">Expiry Date</label><input type="date" class="form-control" name="expiry_date"></div>
        </div>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Add Stock</button></div>
    </form>
  </div></div>
</div>

<%- include('../partials/app-bottom') %>
