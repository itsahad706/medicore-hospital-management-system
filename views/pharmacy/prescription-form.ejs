<%- include('../partials/app-top') %>

<div class="page-header">
  <div><h1>New Prescription</h1></div>
</div>

<div class="form-card">
  <form method="POST" action="/pharmacy/prescriptions">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="appointment_id" value="<%= appointmentId %>">

    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label class="form-label">Patient *</label>
        <select name="patient_id" class="form-select" required>
          <option value="">— Select Patient —</option>
          <% patients.forEach(p => { %>
            <option value="<%= p.id %>" <%= String(preselectPatient)===String(p.id)?'selected':'' %>><%= p.name %> (<%= p.mrn %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">Doctor *</label>
        <% if (currentUser.role === 'doctor') { %>
          <input type="hidden" name="doctor_id" value="<%= doctorId %>">
          <input type="text" class="form-control" value="Dr. <%= currentUser.name %>" disabled>
        <% } else { %>
          <select name="doctor_id" class="form-select" required>
            <option value="">— Select Doctor —</option>
            <% doctorsList.forEach(d => { %>
              <option value="<%= d.id %>">Dr. <%= d.name %></option>
            <% }) %>
          </select>
        <% } %>
      </div>
    </div>

    <table class="table hms-table">
      <thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Qty</th><th></th></tr></thead>
      <tbody id="itemsBody">
        <tr>
          <td style="min-width:180px">
            <select name="medicine_id[]" class="form-select form-select-sm item-select" required>
              <option value="">— Medicine —</option>
              <% medicines.forEach(m => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
            </select>
            <input type="hidden" class="item-desc">
          </td>
          <td><input type="text" name="dosage[]" class="form-control form-control-sm" placeholder="e.g. 500mg"></td>
          <td><input type="text" name="frequency[]" class="form-control form-control-sm" placeholder="e.g. 1-0-1"></td>
          <td><input type="text" name="duration[]" class="form-control form-control-sm" placeholder="e.g. 5 days"></td>
          <td><input type="number" name="quantity[]" class="form-control form-control-sm item-qty" value="1" min="1"></td>
          <td><button type="button" class="btn btn-sm btn-outline-danger remove-row"><i class="bi bi-x"></i></button></td>
        </tr>
      </tbody>
    </table>
    <template id="itemRowTemplate">
      <tr>
        <td style="min-width:180px">
          <select name="medicine_id[]" class="form-select form-select-sm item-select" required>
            <option value="">— Medicine —</option>
            <% medicines.forEach(m => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
          </select>
        </td>
        <td><input type="text" name="dosage[]" class="form-control form-control-sm" placeholder="e.g. 500mg"></td>
        <td><input type="text" name="frequency[]" class="form-control form-control-sm" placeholder="e.g. 1-0-1"></td>
        <td><input type="text" name="duration[]" class="form-control form-control-sm" placeholder="e.g. 5 days"></td>
        <td><input type="number" name="quantity[]" class="form-control form-control-sm item-qty" value="1" min="1"></td>
        <td><button type="button" class="btn btn-sm btn-outline-danger remove-row"><i class="bi bi-x"></i></button></td>
      </tr>
    </template>
    <button type="button" id="addItemRow" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-plus-lg me-1"></i>Add Medicine</button>

    <div class="mb-3">
      <label class="form-label">Notes</label>
      <textarea name="notes" class="form-control" rows="2"></textarea>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">Save Prescription</button>
      <a href="/pharmacy/prescriptions" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/app-bottom') %>
