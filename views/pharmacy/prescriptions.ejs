<%- include('../partials/app-top') %>

<div class="page-header">
  <div><h1>Prescriptions</h1></div>
  <% if (currentUser.role === 'admin' || currentUser.role === 'doctor') { %>
    <a href="/pharmacy/prescriptions/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Prescription</a>
  <% } %>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table hms-table mb-0">
      <thead><tr><th>Date</th><th>Patient</th><th>Doctor</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% if (prescriptions.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-4">No prescriptions yet.</td></tr><% } %>
        <% prescriptions.forEach(p => { %>
          <tr>
            <td><%= new Date(p.created_at).toLocaleDateString() %></td>
            <td><%= p.patient_name %> <span class="text-muted small">(<%= p.mrn %>)</span></td>
            <td>Dr. <%= p.doctor_name %></td>
            <td><span class="badge badge-status bg-<%= p.status==='dispensed'?'success':p.status==='cancelled'?'danger':'warning' %>"><%= p.status %></span></td>
            <td class="text-end"><a href="/pharmacy/prescriptions/<%= p.id %>" class="btn btn-sm btn-outline-secondary">Open</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/app-bottom') %>
