<%- include('../partials/app-top') %>

<div class="page-header">
  <div><h1>Lab Orders</h1></div>
  <% if (currentUser.role === 'admin' || currentUser.role === 'doctor') { %>
    <a href="/lab/orders/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Lab Order</a>
  <% } %>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table hms-table mb-0">
      <thead><tr><th>Date</th><th>Patient</th><th>Doctor</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% if (orders.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-4">No lab orders yet.</td></tr><% } %>
        <% orders.forEach(o => { %>
          <tr>
            <td><%= new Date(o.order_date).toLocaleDateString() %></td>
            <td><%= o.patient_name %> <span class="text-muted small">(<%= o.mrn %>)</span></td>
            <td>Dr. <%= o.doctor_name %></td>
            <td><span class="badge badge-status bg-<%= o.status==='completed'?'success':o.status==='cancelled'?'danger':'warning' %>"><%= o.status %></span></td>
            <td class="text-end"><a href="/lab/orders/<%= o.id %>" class="btn btn-sm btn-outline-secondary">Open</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/app-bottom') %>
