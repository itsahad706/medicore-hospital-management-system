<%- include('../partials/app-top') %>

<div class="page-header">
  <div>
    <h1>Trial Balance</h1>
    <div class="subtitle">
      <a href="/accounting/accounts">Accounts</a> &middot;
      <a href="/accounting/ledger">General Ledger</a> &middot;
      <a href="/accounting/trial-balance">Trial Balance</a>
    </div>
  </div>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table hms-table mb-0">
      <thead><tr><th>Code</th><th>Account</th><th>Type</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead>
      <tbody>
        <% if (rows.length === 0) { %><tr><td colspan="5" class="text-center text-muted py-4">No accounts set up yet.</td></tr><% } %>
        <% rows.forEach(r => { %>
          <tr>
            <td><%= r.code %></td>
            <td><%= r.name %></td>
            <td><span class="badge bg-secondary text-uppercase"><%= r.type %></span></td>
            <td class="text-end"><%= r.total_debit > 0 ? money(r.total_debit) : '—' %></td>
            <td class="text-end"><%= r.total_credit > 0 ? money(r.total_credit) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="invoice-total-row">
          <td colspan="3" class="text-end">Totals</td>
          <td class="text-end"><%= money(totals.debit) %></td>
          <td class="text-end"><%= money(totals.credit) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<% if (Math.abs(totals.debit - totals.credit) > 0.01) { %>
  <div class="alert alert-warning mt-3">Debits and credits are out of balance by <%= money(Math.abs(totals.debit - totals.credit)) %>. Review recent journal entries.</div>
<% } else { %>
  <div class="alert alert-success mt-3">Books are balanced.</div>
<% } %>

<%- include('../partials/app-bottom') %>
