<%- include('../partials/app-top') %>

<div class="page-header">
  <div><h1>Wards &amp; Beds</h1></div>
  <% if (currentUser.role === 'admin') { %>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newWardModal"><i class="bi bi-plus-lg me-1"></i>Add Ward</button>
  <% } %>
</div>

<% if (wards.length === 0) { %>
  <div class="alert alert-secondary">No wards configured yet.</div>
<% } %>

<% wards.forEach(w => { %>
  <div class="table-card mb-3">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
      <div>
        <strong><%= w.name %></strong>
        <span class="badge bg-secondary text-uppercase ms-1"><%= w.type %></span>
        <span class="text-muted small ms-2">Floor <%= w.floor || '—' %> &middot; Rs. <%= Number(w.daily_charge).toFixed(2) %>/day</span>
      </div>
      <span class="small text-muted"><%= w.beds.filter(b=>b.status==='available').length %> / <%= w.beds.length %> beds available</span>
    </div>
    <div class="p-3">
      <div class="bed-grid">
        <% w.beds.forEach(b => { %>
          <div class="bed-tile <%= b.status %>" data-bs-toggle="modal" data-bs-target="#bed<%= b.id %>" style="cursor:pointer">
            <%= b.bed_number %>
            <small class="text-capitalize"><%= b.status %></small>
          </div>
          <div class="modal fade" id="bed<%= b.id %>">
            <div class="modal-dialog modal-sm"><div class="modal-content">
              <form method="POST" action="/wards/beds/<%= b.id %>/status?_method=PUT">
                <%- include('../partials/csrf') %>
                <div class="modal-header"><h6 class="modal-title">Bed <%= b.bed_number %></h6><button class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                  <select name="status" class="form-select">
                    <option value="available" <%= b.status==='available'?'selected':'' %>>Available</option>
                    <option value="occupied" <%= b.status==='occupied'?'selected':'' %>>Occupied</option>
                    <option value="maintenance" <%= b.status==='maintenance'?'selected':'' %>>Maintenance</option>
                  </select>
                </div>
                <div class="modal-footer"><button class="btn btn-primary btn-sm">Update</button></div>
              </form>
            </div></div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
<% }) %>

<div class="modal fade" id="newWardModal">
  <div class="modal-dialog"><div class="modal-content">
    <form method="POST" action="/wards">
      <%- include('../partials/csrf') %>
      <div class="modal-header"><h5 class="modal-title">Add Ward</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label">Ward Name</label><input class="form-control" name="name" required></div>
        <div class="mb-3">
          <label class="form-label">Type</label>
          <select class="form-select" name="type">
            <option value="general">General</option><option value="private">Private</option>
            <option value="icu">ICU</option><option value="emergency">Emergency</option>
            <option value="maternity">Maternity</option><option value="pediatric">Pediatric</option>
          </select>
        </div>
        <div class="mb-3"><label class="form-label">Floor</label><input class="form-control" name="floor"></div>
        <div class="mb-3"><label class="form-label">Daily Bed Charge</label><input type="number" step="0.01" class="form-control" name="daily_charge" value="0"></div>
        <div class="mb-3"><label class="form-label">Number of Beds</label><input type="number" min="1" class="form-control" name="bed_count" value="10" required></div>
      </div>
      <div class="modal-footer"><button class="btn btn-primary">Create Ward</button></div>
    </form>
  </div></div>
</div>

<%- include('../partials/app-bottom') %>
