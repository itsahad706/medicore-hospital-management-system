<%- include('../partials/app-top') %>

<div class="page-header">
  <div><h1>Payments</h1></div>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="table hms-table mb-0">
      <thead><tr><th>Date</th><th>Invoice #</th><th>Patient</th><th>Method</th><th>Reference</th><th>Amount</th></tr></thead>
      <tbody>
        <% if (payments.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4">No payments recorded yet.</td></tr><% } %>
        <% payments.forEach(p => { %>
          <tr>
            <td><%= new Date(p.payment_date).toLocaleString() %></td>
            <td><a href="/billing/invoices/<%= p.invoice_id %>"><%= p.invoice_number %></a></td>
            <td><%= p.patient_name %></td>
            <td class="text-capitalize"><%= p.payment_method.replace('_',' ') %></td>
            <td><%= p.reference_no || '—' %></td>
            <td><%= money(p.amount) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/app-bottom') %>
