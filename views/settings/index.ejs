<%- include('../partials/app-top') %>

<div class="page-header">
  <div><h1>Settings</h1></div>
</div>

<div class="form-card" style="max-width:640px">
  <form method="POST" action="/settings">
    <%- include('../partials/csrf') %>

    <div class="mb-3">
      <label class="form-label">Hospital Name</label>
      <input type="text" name="hospital_name" class="form-control" value="<%= settings.hospital_name %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Address</label>
      <input type="text" name="hospital_address" class="form-control" value="<%= settings.hospital_address %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Phone</label>
      <input type="text" name="hospital_phone" class="form-control" value="<%= settings.hospital_phone %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Currency Symbol</label>
      <input type="text" name="currency_symbol" class="form-control" value="<%= settings.currency_symbol %>">
    </div>
    <div class="mb-3">
      <label class="form-label">Invoice Footer Note</label>
      <textarea name="invoice_footer_note" class="form-control" rows="2"><%= settings.invoice_footer_note %></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Settings</button>
  </form>
</div>

<%- include('../partials/app-bottom') %>
